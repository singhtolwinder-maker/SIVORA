{
  "name": "savora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SAVORA restaurant API — authentication, menu, cart, orders, reservations, contact and admin.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "admin:reset": "node src/scripts/reset-admin.js",
    "test": "node --import ./tests/env.js --test --test-concurrency=1 tests/",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.9.1",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4"
  }
}
