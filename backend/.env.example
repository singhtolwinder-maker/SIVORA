# ---------------------------------------------------------------------------
# SAVORA API — environment template. Copy to .env and fill in real values.
# Never commit .env. Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api

# MongoDB. Local: mongodb://127.0.0.1:27017/savora
# Atlas:   mongodb+srv://<user>:<password>@<cluster>/savora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/savora

# Comma-separated list of browser origins allowed to call the API with cookies.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — both secrets must be 32+ random characters.
JWT_ACCESS_SECRET=replace-with-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-64-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Cookies (secure is forced on in production regardless of this value)
COOKIE_DOMAIN=
COOKIE_SECURE=false
# lax = site and API share an origin (recommended, incl. a Vercel rewrite).
# none = API on a different site over HTTPS; blocked by some third-party-cookie
# policies (Safari, Chrome incognito), so prefer a proxy if you can.
COOKIE_SAMESITE=lax

# Restaurant operations
RESTAURANT_TIMEZONE=America/New_York
TAX_RATE=0.08875
DELIVERY_FEE_CENTS=499
FREE_DELIVERY_THRESHOLD_CENTS=7500
RESERVATION_SLOT_CAPACITY=24
RESERVATION_MAX_PARTY=12
RESERVATION_LEAD_DAYS=90

# Public URL of the admin/customer app, used in password-reset links.
APP_URL=http://localhost:5173

# Stripe — leave blank to keep payments disabled (endpoints return 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Seed admin credentials (used by `npm run seed`).
# SEED_ADMIN_PASSWORD is required in production — the script refuses to create
# an administrator there without it. Generate one; never ship a known default.
SEED_ADMIN_EMAIL=admin@savora.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Savora Admin

# Optional: hash client IPs stored with contact messages (privacy).
IP_HASH_SALT=replace-with-a-random-string
