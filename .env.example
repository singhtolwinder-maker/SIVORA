# Frontend environment (Vite). Copy to .env.local — never commit secrets.
#
# Leave VITE_API_URL empty in development: requests go to /api and are proxied
# to the backend by vite.config.js. In production set it to the API origin,
# e.g. https://api.savora.com/api
VITE_API_URL=

# Optional: where `npm run dev` proxies /api (defaults to the local backend).
VITE_API_PROXY=http://127.0.0.1:4000
